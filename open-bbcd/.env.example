# Database
DATABASE_URL=postgres://openbbcd:openbbcd@localhost:5432/openbbcd?sslmode=disable

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Discovery upload cap. The uploaded zip is persisted into Postgres as
# BYTEA (migration 026) — no local-disk state.
DISCOVERY_MAX_UPLOAD_MB=50

# Anthropic chat runtime (required when /agents/{id}/chat/... is used)
ANTHROPIC_API_KEY=
OPENBBC_DEFAULT_MODEL=claude-sonnet-4-6
OPENBBC_MAX_TOKENS=4096

# Chat transport + orchestrator loop bounds
OPENBBC_CHAT_TRANSPORT=agui
OPENBBC_MAX_TOOL_ROUNDS=10
# Sub-agent tool: max nesting depth (root = 0) and max concurrent agent calls per step (integers >= 1)
AGENT_TOOL_MAX_DEPTH=3
AGENT_TOOL_MAX_PARALLEL=4

# --- Chat artifacts (optional) ---------------------------------------
#
# Enable the chat-artifacts feature by declaring at least one artifact
# store group. When no ARTIFACT_STORE_* groups are configured, the
# feature is off and the /artifacts routes are not registered.
#
# Store slug rules (the <ID> segment below):
#   - uppercase letter followed by uppercase alphanumeric (no underscore,
#     no dash, no leading digit).
#   - stable across deploys — the slug becomes the `store_id` embedded
#     in every artifact_ref persisted to chat_messages.content JSONB.
#     Renaming a slug breaks every historical ref that points at it.
#   - reserved: DEFAULT, MAX_UPLOAD_MB, SIGNED_URL_TTL_SECONDS.
#
# Adapter kinds shipped: s3_compatible (AWS S3, MinIO, GCS with HMAC,
# R2, B2, any S3-API endpoint).
#
# Example — MinIO in the artifacts compose profile:
# ARTIFACT_STORE_MAIN_KIND=s3_compatible
# ARTIFACT_STORE_MAIN_ENDPOINT=http://minio:9000
# ARTIFACT_STORE_MAIN_BUCKET=openbbc-artifacts
# ARTIFACT_STORE_MAIN_REGION=us-east-1
# ARTIFACT_STORE_MAIN_ACCESS_KEY=minioadmin
# ARTIFACT_STORE_MAIN_SECRET_KEY=minioadmin
# ARTIFACT_STORE_MAIN_PATH_STYLE=true
#
# Example — AWS S3:
# ARTIFACT_STORE_MAIN_KIND=s3_compatible
# ARTIFACT_STORE_MAIN_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# ARTIFACT_STORE_MAIN_BUCKET=my-openbbc-artifacts
# ARTIFACT_STORE_MAIN_REGION=eu-west-1
# ARTIFACT_STORE_MAIN_ACCESS_KEY=AKIA...
# ARTIFACT_STORE_MAIN_SECRET_KEY=...
#
# Global: nominates which store receives new uploads. Reads route via
# the store_id embedded in each ref so old refs keep working after
# this flips across redeploys.
# ARTIFACT_STORE_DEFAULT=MAIN
#
# Per-upload cap enforced at the multipart boundary. Required when the
# feature is enabled.
# ARTIFACT_MAX_UPLOAD_MB=25
#
# Optional: TTL for presigned-URL retrieval responses (default 300s).
# ARTIFACT_SIGNED_URL_TTL_SECONDS=300
#
# Optional: max pending (uploaded, not yet claimed by a turn) artifacts
# per session (default 10, must be >= 1).
# ARTIFACT_MAX_PENDING=10
